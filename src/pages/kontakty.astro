---
import Layout from '../layouts/Layout.astro';
import FontPreload from '../components/FontPreload.astro';
---

<Layout 
  title="Kontakty - Farnost Hrochův Týnec - Chroustovice"
  description="Kontaktní údaje na duchovního správce a farnosti Hrochův Týnec a Chroustovice."
>
  <FontPreload />

  <div class="page-hero">
    <h2>Kontakty</h2>
  </div>

  <section class="content-section">
    <div class="liturgical-files-section">
      <div class="content-text">
        
        <div class="two-column-layout">
          <!-- Sloupec 1: HT + Fas -->
          <div class="column ht-column">
            <!-- Farnost Hrochův Týnec -->
            <div class="contact-section">
              <h3>Římskokatolická farnost Hrochův Týnec:</h3>
              <div class="contact-card parish-card">
                <div class="contact-details">
                  <p><strong>e-mail:</strong> <a href="mailto:farnost@farnostht-chr.cz">farnost@farnostht-chr.cz</a></p>
                  <p><strong>IČO:</strong> 60104741</p>
                  <p><strong>Datová schránka:</strong> ai9e2j9</p>
                  <p><strong>číslo účtu:</strong> 1142554329/0800</p>
                </div>
              </div>
            </div>

            <!-- Duchovní správce -->
            <div class="contact-section">
              <div class="contact-card priest-card">
                <h4>P. ThMgr. Mirosław Piotr Fąs MSF</h4>
                <p class="priest-note">(vede správu farnosti Hrochův Týnec i Chroustovice)</p>
                <div class="contact-details">
                  <p><strong>tel.:</strong> <a href="tel:+420731598782">+420 731 598 782</a></p>
                  <p><strong>e-mail:</strong> <a href="mailto:fas@farnostht-chr.cz">fas@farnostht-chr.cz</a></p>
                  <p><strong>adresa:</strong> Podborská 57 <br/> 538 062 Hrochův Týnec</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Sloupec 2: Chroustovice + Šilhánek -->
          <div class="column chr-column">
            <!-- Farnost Chroustovice -->
            <div class="contact-section">
              <h3>Římskokatolická farnost Chroustovice:</h3>
              <div class="contact-card parish-card">
                <div class="contact-details">
                  <p><strong>e-mail:</strong> <a href="mailto:farnost@farnostht-chr.cz">farnost@farnostht-chr.cz</a></p>
                  <p><strong>IČO:</strong> 64783243</p>
                  <p><strong>Datová schránka:</strong> dqde2kk</p>
                  <p><strong>Číslo účtu:</strong> 1233567379/0800</p>
                </div>
              </div>
            </div>

            <!-- P. Zdeněk Šilhánek -->
            <div class="contact-section">
              <div class="contact-card priest-card">
                <h4>P. Mgr. Zdeněk Šilhánek</h4>
                <p class="priest-note">(bydlí ve farnosti Chroustovice)</p>
                <div class="contact-details">
                  <p><strong>tel.:</strong> <a href="tel:+420731646994">+420 731 646 994</a></p>
                  <p><strong>e-mail:</strong> <a href="mailto:silhanek@farnostht-chr.cz">silhanek@farnostht-chr.cz</a></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Kontaktní formulář -->
        <div class="contact-section">
          <h3>V případě libovolného dotazu nás kontaktujte zde:</h3>
          <div class="contact-form">
            <form 
              id="contactForm"
              method="POST"
            >
              <!-- Metadata pro Google Apps Script -->
              <input type="hidden" name="formType" value="Kontaktní formulář" />
              <input type="hidden" name="sentAt" id="sentAtField" value="" />
              
              <!-- Anti-spam honeypot -->
              <input type="text" id="honey" name="website" style="display:none" />
              
              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">Jméno a příjmení *</label>
                  <input type="text" id="firstName" name="Jméno" placeholder="Jan" required>
                </div>
                <div class="form-group">
                  <label for="lastName">&nbsp;</label>
                  <input type="text" id="lastName" name="Příjmení" placeholder="Novák">
                </div>
              </div>
              
              <div class="form-group">
                <label for="email">E-mail *</label>
                <input type="email" id="email" name="E-mail" placeholder="Váš e-mail" required>
              </div>
              
              <div class="form-group">
                <label for="subject">Předmět zprávy *</label>
                <input type="text" id="subject" name="Předmět" placeholder="Dotaz" required>
              </div>
              
              <div class="form-group">
                <label for="message">Text *</label>
                <textarea id="message" name="Zpráva" rows="5" placeholder="Zpráva" required></textarea>
              </div>
              
              <button type="submit" class="submit-btn">Odeslat zprávu</button>
            </form>
          </div>
        </div>

        <!-- Technická podpora -->
        <div class="contact-section">
          <h3>Technická podpora webu:</h3>
          <div class="contact-card support-card">
            <div class="contact-details">
              <p><strong>e-mail:</strong> <a href="mailto:podpora@farnostht-chr.cz">podpora@farnostht-chr.cz</a></p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzEYuT42uXiV6uy2lsefqLJ2eYmXdpdRTXfPmAUesOlqY5SX34VmB-H9DaTW4ZsCwd3/exec';

  // Zpracování kontaktního formuláře
  const form = document.getElementById('contactForm') as HTMLFormElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Odesílám...';
    
    try {
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const firstNameInput = document.getElementById('firstName') as HTMLInputElement;
      const lastNameInput = document.getElementById('lastName') as HTMLInputElement;
      const subjectInput = document.getElementById('subject') as HTMLInputElement;
      const messageInput = document.getElementById('message') as HTMLTextAreaElement;
      const sentAtField = document.getElementById('sentAtField') as HTMLInputElement;
      const honeyField = document.getElementById('honey') as HTMLInputElement;
      if (sentAtField) {
        sentAtField.value = new Date().toLocaleString('cs-CZ', { timeZone: 'Europe/Prague' });
      }

      const firstName = firstNameInput?.value?.trim() ?? '';
      const lastName = lastNameInput?.value?.trim() ?? '';
      const fullName = `${firstName} ${lastName}`.trim();
      const messageSubject = subjectInput?.value?.trim() || 'Bez předmětu';
      const senderEmail = emailInput?.value?.trim() ?? '';

      const payload = new URLSearchParams({
        formType: 'Kontaktní formulář',
        sentAt: sentAtField?.value ?? '',
        firstName,
        lastName,
        fullName,
        email: senderEmail,
        replyTo: senderEmail,
        subject: messageSubject,
        message: messageInput?.value?.trim() ?? '',
        honey: honeyField?.value?.trim() ?? '',
        emailSubject: `Dotaz z webu | ${fullName || 'Neznámý odesílatel'} | ${messageSubject}`
      });
      
      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: payload,
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
        }
      });

      alert('Děkujeme za Vaši zprávu. Odpovíme Vám co nejdříve.');
      form.reset();
    } catch (error) {
      console.error('Chyba:', error);
      alert('Omlouváme se, došlo k chybě při odesílání. Zkuste to prosím znovu nebo nás kontaktujte telefonicky.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
