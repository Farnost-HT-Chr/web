---
import Layout from '../layouts/Layout.astro';
import FontPreload from '../components/FontPreload.astro';
---

<Layout 
  title="Farní rada - Farnost Hrochův Týnec - Chroustovice"
  description="Členové farní rady a záznamy z jejích zasedání ve farnosti Hrochův Týnec - Chroustovice."
>
  <FontPreload />

  <div class="page-hero">
    <h2>Farní rada</h2>
  </div>

  <section class="content-section">
    <div class="liturgical-files-section">
      <div class="content-text">
        
        <div class="council-images">
          <div class="council-image-item">
            <img src="/images/fr_jmenovani.webp" alt="Jmenování farní rady" class="council-member-image" />
          </div>
          <div class="council-image-item">
            <img src="/images/members1.webp" alt="Členové farní rady" class="council-member-image" />
          </div>
          <div class="council-image-item">
            <img src="/images/members2.webp" alt="Členové farní rady" class="council-member-image" />
          </div>
        </div>

        <div class="two-column-layout">
          <div class="column members-column">
            <h3>Členové farní rady:</h3>
            
            <div class="members-list">
              <div class="member-item chairman">
                <p><strong>P. Mirosław Piotr Fąs, MSF</strong> – předseda</p>
              </div>
              
              <div class="member-item vice-chairman">
                <p><strong>p. Petr Schejbal</strong> – místopředseda</p>
              </div>
              
              <div class="member-item secretary">
                <p><strong>pí Věra Filipiová</strong> – sekretářka</p>
              </div>
              
              <div class="member-item">
                <p>pí Veronika Bakešová</p>
              </div>
              
              <div class="member-item">
                <p>pí Eva Beranová st.</p>
              </div>
              
              <div class="member-item">
                <p>p. Josef Beran</p>
              </div>
              
              <div class="member-item">
                <p>p. Martin Beran</p>
              </div>
              
              <div class="member-item">
                <p>p. Jan Johanides</p>
              </div>
              
              <div class="member-item">
                <p>pí Alena Schejbalová</p>
              </div>
              
              <div class="member-item">
                <p>pí Zdeňka Šotolová</p>
              </div>
              
              <div class="member-item">
                <p>pí Monika Velinská</p>
              </div>
            </div>
          </div>

          <div class="column minutes-column">
            <h3>Zápisy ze zasedání farní rady:</h3>
            
            <div class="minutes-list">
              <div class="minute-item">
                <a href="/farni_rada/3.10.2023.pdf" target="_blank" rel="noopener noreferrer">
                  <span class="file-title">Zápis ze dne 3.10.2023</span>
                </a>
              </div>
              
              <div class="minute-item">
                <a href="/farni_rada/25.6.2023.pdf" target="_blank" rel="noopener noreferrer">
                  <span class="file-title">Zápis ze dne 25.6.2023</span>
                </a>
                </div>

                   <div class="minute-item">
                <a href="/farni_rada/7.7.2025.pdf" target="_blank" rel="noopener noreferrer">
                  <span class="file-title">Zápis ze dne 7.7.2025</span>
               </a>
               </div>

           <div class="minute-item">
                <a href="/farni_rada/2.12.2025.pdf" target="_blank" rel="noopener noreferrer">
                  <span class="file-title">Zápis ze dne 2.12.2025</span>
               </a>
              </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
