---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Rezervace intence - Farnost Hrochův Týnec - Chroustovice"
  description="Rezervace mešní intence ve farnosti Hrochův Týnec a Chroustovice."
>
  <div class="page-hero">
    <h2>Rezervace intence</h2>
  </div>

  <section class="content-section">
    <form 
      id="intenceForm" 
      class="intence-form"
      method="POST"
    >
      <!-- Metadata pro Google Apps Script -->
      <input type="hidden" name="formType" value="Rezervace mešní intence" />
      <input type="hidden" name="sentAt" id="sentAtField" value="" />
      
      <!-- Anti-spam honeypot -->
      <input type="text" id="honey" name="website" style="display:none" />
      
      <!-- Jméno a příjmení -->
      <div class="form-row">
        <div class="form-group">
          <label for="firstName">
            Křestní jméno <span class="required">*</span>
          </label>
          <input 
            type="text" 
            id="firstName" 
            name="Jméno" 
            placeholder="Jan"
            required
          />
        </div>

        <div class="form-group">
          <label for="lastName">
            Příjmení <span class="required">*</span>
          </label>
          <input 
            type="text" 
            id="lastName" 
            name="Příjmení" 
            placeholder="Novák"
            required
          />
        </div>
      </div>

      <!-- Telefon -->
      <div class="form-group">
        <label for="phone">
          Telefon <span class="required">*</span>
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="Telefon" 
          placeholder="+420777777777"
          required
        />
      </div>

      <!-- E-mail -->
      <div class="form-group">
        <label for="email">
          E-mail <span class="required">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="E-mail" 
          placeholder="jan.novak@gmail.com"
          required
        />
      </div>

      <!-- Datum -->
      <div class="form-group">
        <label for="customDate">
          Datum <span class="required">*</span>
        </label>
        <input 
          type="text" 
          id="customDate" 
          name="Datum bohoslužby" 
          placeholder="15.3.2026"
        />
      </div>

      <!-- Ve farnosti -->
      <div class="form-group">
        <label for="parish">
          Ve farnosti <span class="required">*</span>
        </label>
        <select id="parish" name="Farnost" required>
          <option value="Hrochův Týnec">Hrochův Týnec</option>
          <option value="Chroustovice">Chroustovice</option>
        </select>
      </div>

      <!-- Znění intence -->
      <div class="form-group">
        <label for="intention">
          Napište přesné znění intence <span class="required">*</span>
        </label>
        <textarea 
          id="intention" 
          name="Znění intence" 
          rows="4"
          required
        ></textarea>
      </div>

      <!-- Tlačítko -->
      <button type="submit" class="submit-btn">
        Rezervovat intenci
      </button>
    </form>

    <!-- Informační boxy -->
    <div class="info-box calendar-info">
      <p>
        Aktuální informace o již plánovaných intencích naleznete v kalendáři 
        <a href="/kalendar">zde</a>.
      </p>
    </div>

    <div class="info-box important">
      <p>
        <strong>Rezervace je platná až po jejím potvrzení e-mailem.</strong>
      </p>
    </div>
  </section>
</Layout>

<script>
  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxyJvULd52bCR-ZZKPAHKJH4xt81L81fn7BuN_p5qyxUkUK0XT1MkTMlSwVfgWs_rk/exec';

  // Zpracování formuláře
  const form = document.getElementById('intenceForm') as HTMLFormElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Odesílám...';
    
    try {
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const firstNameInput = document.getElementById('firstName') as HTMLInputElement;
      const lastNameInput = document.getElementById('lastName') as HTMLInputElement;
      const phoneInput = document.getElementById('phone') as HTMLInputElement;
      const dateInput = document.getElementById('customDate') as HTMLInputElement;
      const parishSelect = document.getElementById('parish') as HTMLSelectElement;
      const intentionInput = document.getElementById('intention') as HTMLTextAreaElement;
      const sentAtField = document.getElementById('sentAtField') as HTMLInputElement;
      const honeyField = document.getElementById('honey') as HTMLInputElement;
      if (sentAtField) {
        sentAtField.value = new Date().toLocaleString('cs-CZ', { timeZone: 'Europe/Prague' });
      }

      const firstName = firstNameInput?.value?.trim() ?? '';
      const lastName = lastNameInput?.value?.trim() ?? '';
      const fullName = `${firstName} ${lastName}`.trim();
      const parish = parishSelect?.value ?? '';
      const dateText = dateInput?.value?.trim() || 'neuvedeno';
      const senderEmail = emailInput?.value?.trim() ?? '';

      const payload = new URLSearchParams({
        formType: 'Rezervace mešní intence',
        sentAt: sentAtField?.value ?? '',
        firstName,
        lastName,
        fullName,
        phone: phoneInput?.value?.trim() ?? '',
        email: senderEmail,
        replyTo: senderEmail,
        parish,
        serviceDate: dateText,
        intention: intentionInput?.value?.trim() ?? '',
        honey: honeyField?.value?.trim() ?? '',
        emailSubject: `📅 Rezervace intence | ${fullName || 'Neznámý odesílatel'} | ${parish || 'Neurčená farnost'} | ${dateText}`
      });
      
      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: payload,
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
        }
      });

      alert('Děkujeme za odeslání rezervace intence. Brzy obdržíte potvrzovací e-mail.');
      form.reset();
    } catch (error) {
      console.error('Chyba:', error);
      alert('Omlouváme se, došlo k chybě při odesílání. Zkuste to prosím znovu nebo nás kontaktujte telefonicky.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>