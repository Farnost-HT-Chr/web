---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Rezervace intence - Farnost Hrochův Týnec - Chroustovice"
  description="Rezervace mešní intence ve farnosti Hrochův Týnec a Chroustovice."
>
  <div class="page-hero">
    <h2>Rezervace intence</h2>
  </div>

  <section class="content-section">
    <form 
      id="intenceForm" 
      class="intence-form"
      action="https://formsubmit.co/fas@farnostht-chr.cz"
      method="POST"
    >
      <!-- FormSubmit konfigurace -->
      <input type="hidden" name="_subject" value="📅 Nová rezervace mešní intence - Farnost HT-CHR" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      
      <!-- Reply-to bude nastaveno na e-mail odesílatele formuláře -->
      <input type="hidden" name="_replyto" id="replyToField" value="" />
      
      <!-- Auto-reply configuration (sends confirmation to user) -->
      <input type="hidden" name="_autoresponse" value="Dobrý den,

děkujeme za odeslání rezervace mešní intence prostřednictvím našeho webového formuláře.

Vaši žádost jsme obdrželi a zpracujeme ji v nejbližší možné době. O přijetí a potvrzení intence vás budeme informovat e-mailem nebo telefonicky.

V případě dotazů nás můžete kontaktovat:
📞 Telefon: 731 598 782
✉️ Email: fas@farnostht-chr.cz

S pozdravem,
Římskokatolická farnost Hrochův Týnec - Chroustovice" />
      
      <!-- Anti-spam honeypot -->
      <input type="text" name="_honey" style="display:none" />
      
      <!-- Jméno a příjmení -->
      <div class="form-row">
        <div class="form-group">
          <label for="firstName">
            Křestní jméno <span class="required">*</span>
          </label>
          <input 
            type="text" 
            id="firstName" 
            name="Jméno" 
            placeholder="Jan"
            required
          />
        </div>

        <div class="form-group">
          <label for="lastName">
            Příjmení <span class="required">*</span>
          </label>
          <input 
            type="text" 
            id="lastName" 
            name="Příjmení" 
            placeholder="Novák"
            required
          />
        </div>
      </div>

      <!-- Telefon -->
      <div class="form-group">
        <label for="phone">
          Telefon <span class="required">*</span>
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="Telefon" 
          placeholder="+420777777777"
          required
        />
      </div>

      <!-- E-mail -->
      <div class="form-group">
        <label for="email">
          E-mail <span class="required">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="E-mail" 
          placeholder="jan.novak@gmail.com"
          required
        />
      </div>

      <!-- Datum -->
      <div class="form-group">
        <label for="customDate">
          Datum <span class="required">*</span>
        </label>
        <input 
          type="text" 
          id="customDate" 
          name="Datum bohoslužby" 
          placeholder="15.3.2026"
        />
      </div>

      <!-- Ve farnosti -->
      <div class="form-group">
        <label for="parish">
          Ve farnosti <span class="required">*</span>
        </label>
        <select id="parish" name="Farnost" required>
          <option value="Hrochův Týnec">Hrochův Týnec</option>
          <option value="Chroustovice">Chroustovice</option>
        </select>
      </div>

      <!-- Znění intence -->
      <div class="form-group">
        <label for="intention">
          Napište přesné znění intence <span class="required">*</span>
        </label>
        <textarea 
          id="intention" 
          name="Znění intence" 
          rows="4"
          required
        ></textarea>
      </div>

      <!-- Tlačítko -->
      <button type="submit" class="submit-btn">
        Rezervovat intenci
      </button>
    </form>

    <!-- Informační boxy -->
    <div class="info-box calendar-info">
      <p>
        Aktuální informace o již plánovaných intencích naleznete v kalendáři 
        <a href="/kalendar">zde</a>.
      </p>
    </div>

    <div class="info-box important">
      <p>
        <strong>Rezervace je platná až po jejím potvrzení e-mailem.</strong>
      </p>
    </div>
  </section>
</Layout>

<script>
  // Zpracování formuláře
  const form = document.getElementById('intenceForm') as HTMLFormElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Odesílám...';
    
    try {
      const formData = new FormData(form);
      
      // Nastavit reply-to na e-mail odesílatele
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const replyToField = document.getElementById('replyToField') as HTMLInputElement;
      if (emailInput && replyToField) {
        replyToField.value = emailInput.value;
      }
      
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });
      
      if (response.ok) {
        alert('Děkujeme za odeslání rezervace intence. Brzy obdržíte potvrzovací e-mail.');
        form.reset();
      } else {
        alert('Omlouváme se, došlo k chybě při odesílání. Zkuste to prosím znovu nebo nás kontaktujte telefonicky.');
      }
    } catch (error) {
      console.error('Chyba:', error);
      alert('Omlouváme se, došlo k chybě při odesílání. Zkuste to prosím znovu nebo nás kontaktujte telefonicky.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>