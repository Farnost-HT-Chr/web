---
import Layout from '../layouts/Layout.astro';
import PdfItem from '../components/PdfItem.astro';
import fs from 'fs';
import path from 'path';

// Get all PDF files from public/announcements directory
let pdfFiles: { name: string; path: string }[] = [];

try {
  const announcementsDir = path.join(process.cwd(), 'public', 'announcements');
  
  const files = fs.readdirSync(announcementsDir);
  pdfFiles = files
    .filter(file => file.toLowerCase().endsWith('.pdf'))
    .map(file => ({
      name: file.replace('.pdf', ''),
      path: `/announcements/${file}`
    }))
    .sort((a, b) => {
      // Helper function to extract and normalize date from filename
      const extractDate = (filename: string): Date | null => {
        // Format: DD.MM.YYYY or D.M.YYYY (e.g., 1.9.2020, 23.12.2025)
        const ddmmyyyyRegex = /(\d{1,2})\.(\d{1,2})\.(\d{4})/;
        // Format: YYYY-MM-DD or YYYY.MM.DD (e.g., 2024-12-25, 2024.12.25)
        const yyyymmddRegex = /(\d{4})[-.](\d{1,2})[-.](\d{1,2})/;
        
        let match = filename.match(ddmmyyyyRegex);
        if (match) {
          const [, day, month, year] = match;
          return new Date(parseInt(year), parseInt(month) - 1, parseInt(day));
        }
        
        match = filename.match(yyyymmddRegex);
        if (match) {
          const [, year, month, day] = match;
          return new Date(parseInt(year), parseInt(month) - 1, parseInt(day));
        }
        
        return null;
      };
      
      const dateA = extractDate(a.name);
      const dateB = extractDate(b.name);
      
      // If both have valid dates, compare them
      if (dateA && dateB) {
        return dateB.getTime() - dateA.getTime(); // Descending order (newest first)
      }
      
      // If only one has a date, prioritize it
      if (dateA) return -1;
      if (dateB) return 1;
      
      // If neither has a date, sort alphabetically descending
      return b.name.localeCompare(a.name);
    });
} catch (error) {
  console.error('Error reading PDF files:', error);
}

const itemsPerPage = 6;
const remainingItems = pdfFiles.length - itemsPerPage;
---

<Layout 
  title="Ohlášky - Farnost Hrochův Týnec - Chroustovice"
  description="Aktuální ohlášky a oznámení farnosti Hrochův Týnec - Chroustovice."
>
  <div class="container">
    <h1 class="page-title">Ohlášky</h1>
        
      {pdfFiles.length === 0 ? (
        <div class="no-pdfs">
          <p>Momentálně nejsou k dispozici žádné ohlášky.</p>
        </div>
      ) : (
        <>
          <div class="pdf-list">
            {/* Prvních X položek, které jsou vidět vždy */}
            {pdfFiles.slice(0, itemsPerPage).map((pdf, index) => (
              <PdfItem name={pdf.name} path={pdf.path} index={index} />
            ))}

            {/* Skrytý kontejner pro zbytek ohlášek */}
            {pdfFiles.length > itemsPerPage && (
              <div class="extra-items-container" id="extraItems">
                {pdfFiles.slice(itemsPerPage).map((pdf, index) => {
                  const globalIndex = index + itemsPerPage;
                  return (
                    <PdfItem name={pdf.name} path={pdf.path} index={globalIndex} />
                  );
                })}
              </div>
            )}
          </div>

          {pdfFiles.length > itemsPerPage && (
            <div class="pagination">
              <button class="load-more-btn" id="toggleExtraBtn">
                <span class="btn-text" id="btnText">
                  <span>📄 Zobrazit starší ohlášky</span>
                  <span class="count">+{remainingItems}</span>
                </span>
              </button>
            </div>
          )}
        </>
      )}
    </div>

  <script is:inline>
    window.togglePDF = function(index) {
      const pdfItem = document.querySelector(`[data-pdf-id="${index}"]`);
      if (pdfItem) {
        const isExpanding = !pdfItem.classList.contains('expanded');
        pdfItem.classList.toggle('expanded');
        
        if (isExpanding) {
          const iframe = pdfItem.querySelector('.pdf-viewer');
          const pdfSrc = iframe?.getAttribute('data-pdf-src');
          if (iframe && pdfSrc && !iframe.src) {
            iframe.src = pdfSrc;
          }
        }
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      // Add click handlers to ALL pdf headers (including extra items)
      document.querySelectorAll('.pdf-header').forEach((header) => {
        header.addEventListener('click', (e) => {
          // Don't toggle if clicking on download button
          if (!e.target.closest('.pdf-actions')) {
            const pdfItem = header.closest('.pdf-item');
            const index = pdfItem?.getAttribute('data-pdf-id');
            if (index !== null) {
              togglePDF(parseInt(index));
            }
          }
        });
      });

      const toggleBtn = document.getElementById('toggleExtraBtn');
      const extraItems = document.getElementById('extraItems');
      const btnText = document.getElementById('btnText');

      if (toggleBtn && extraItems) {
        toggleBtn.addEventListener('click', () => {
          const isOpen = extraItems.classList.toggle('is-open');
          
          // Změna textu tlačítka
          if (isOpen) {
            btnText.innerHTML = '<span>▲ Zobrazit méně</span>';
          } else {
            btnText.innerHTML = '<span>📄 Zobrazit starší ohlášky</span><span class="count">+' + (extraItems.children.length) + '</span>';
            
            // Volitelné: Odrolovat zpět nahoru k začátku seznamu při zavření
            extraItems.scrollIntoView({ behavior: 'smooth', block: 'end' });
          }
        });
      }
    });
  </script>
</Layout>
