---
import Layout from '../layouts/Layout.astro';
import FontPreload from '../components/FontPreload.astro';
import fs from 'fs';
import path from 'path';

// Načtení PDF souborů z adresáře announcements a seskupení podle let
const announcementsDir = path.join(process.cwd(), 'public', 'announcements');
let pdfsByYear: Record<string, Array<{fileName: string, filePath: string}>> = {};

// Funkce pro extrakci roku z názvu souboru
const extractYearFromFile = (filename: string): string => {
  // Pokus o extrakci roku z názvu souboru
  // Format: DD.MM.YYYY nebo D.M.YYYY (např. 1.9.2020, 23.12.2025)
  const ddmmyyyyRegex = /(\d{1,2})\.(\d{1,2})\.(\d{4})/;
  // Format: YYYY-MM-DD nebo YYYY.MM.DD (např. 2024-12-25, 2024.12.25)
  const yyyymmddRegex = /(\d{4})[-.]\d{1,2}[-.]\d{1,2}/;
  
  let match = filename.match(yyyymmddRegex);
  if (match) {
    return match[1];
  }
  
  match = filename.match(ddmmyyyyRegex);
  if (match) {
    return match[3];
  }
  
  // Pokud rok není v názvu, použij aktuální rok
  return new Date().getFullYear().toString();
};

// Funkce pro parsování data z názvu souboru pro řazení
const parseDateFromFilename = (filename: string): Date => {
  const ddmmyyyyRegex = /(\d{1,2})\.(\d{1,2})\.(\d{4})/;
  const match = filename.match(ddmmyyyyRegex);
  
  if (match) {
    const day = parseInt(match[1], 10);
    const month = parseInt(match[2], 10) - 1; // JavaScript měsíce jsou 0-indexované
    const year = parseInt(match[3], 10);
    return new Date(year, month, day);
  }
  
  // Pokud se nepodaří parsovat datum, vrátí epoch
  return new Date(0);
};

try {
  if (fs.existsSync(announcementsDir)) {
    const files = fs.readdirSync(announcementsDir);
    const pdfFileList = files.filter(file => file.toLowerCase().endsWith('.pdf'));
    
    if (pdfFileList.length > 0) {
      pdfFileList.forEach(file => {
        const year = extractYearFromFile(file);
        
        if (!pdfsByYear[year]) {
          pdfsByYear[year] = [];
        }
        
        pdfsByYear[year].push({
          fileName: file,
          filePath: file
        });
      });
      
      // Seřazení souborů v každém roce podle data v názvu souboru (nejnovější první)
      Object.keys(pdfsByYear).forEach(year => {
        pdfsByYear[year].sort((a, b) => {
          const dateA = parseDateFromFilename(a.fileName);
          const dateB = parseDateFromFilename(b.fileName);
          return dateB.getTime() - dateA.getTime();
        });
      });
    }
    
    // Seřazení let sestupně (nejnovější první)
    const sortedYears = Object.keys(pdfsByYear).sort((a, b) => {
      const yearA = parseInt(a, 10);
      const yearB = parseInt(b, 10);
      
      if (isNaN(yearA) && isNaN(yearB)) return b.localeCompare(a);
      if (isNaN(yearA)) return 1;
      if (isNaN(yearB)) return -1;
      
      return yearB - yearA;
    });
    
    pdfsByYear = sortedYears.reduce((obj, key) => {
      obj[key] = pdfsByYear[key];
      return obj;
    }, {} as Record<string, Array<{fileName: string, filePath: string}>>);
  }
} catch (error) {
  console.error('Chyba při načítání PDF souborů:', error);
}

// Získání aktuálního roku a rozdělení dat
const currentYear = new Date().getFullYear().toString();
const allYears = Object.keys(pdfsByYear);
const currentYearData = pdfsByYear[currentYear] || [];
// Ostatní roky (starší) - obrácené pořadí (od nejstaršího k nejnovějšímu)
const otherYears = allYears.filter(year => year !== currentYear).reverse();
---

<Layout 
  title="Ohlášky - Farnost Hrochův Týnec - Chroustovice"
  description="Aktuální ohlášky a oznámení farnosti Hrochův Týnec - Chroustovice."
>
  <FontPreload />

  <div class="container">
    <!-- Ohlášky ke stažení -->
    <h1 class="page-title">Ohlášky</h1>
    <div class="liturgical-files-section">
          
          {Object.keys(pdfsByYear).length === 0 ? (
            <div class="no-files">
              <p>Momentálně nejsou k dispozici žádné ohlášky.</p>
            </div>
          ) : (
            <>
              <div class="files-by-year">
                <!-- Aktuální rok - vždy viditelný -->
                {currentYearData.length > 0 ? (
                  <div class="year-group" data-year={currentYear}>
                    <h4 class="year-header">{currentYear}</h4>
                    <div class="files-grid">
                      {currentYearData.map(({fileName, filePath}) => {
                        const displayName = fileName
                          .replace('.pdf', '')
                          .replace(/^\d{4}-\d{2}-\d{2}[-_]?/, '')
                          .replace(/[-_]/g, ' ')
                          .trim();
                        
                        return (
                          <a 
                            href={`/announcements/${filePath}`} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="file-item clickable"
                            aria-label={`Zobrazit ${displayName}`}
                          >
                            <div class="file-info">
                              <span class="file-icon">📄</span>
                              <span class="file-name">{displayName}</span>
                            </div>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                ) : allYears.length > 0 && (
                  <div class="year-group" data-year={allYears[0]}>
                    <h4 class="year-header">{allYears[0]}</h4>
                    <div class="files-grid">
                      {pdfsByYear[allYears[0]].map(({fileName, filePath}) => {
                        const displayName = fileName
                          .replace('.pdf', '')
                          .replace(/^\d{4}-\d{2}-\d{2}[-_]?/, '')
                          .replace(/[-_]/g, ' ')
                          .trim();
                        
                        return (
                          <div class="file-item-wrapper">
                            <a 
                              href={`/announcements/${filePath}`} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="file-item clickable"
                              aria-label={`Zobrazit ${displayName}`}
                            >
                              <div class="file-info">
                                <span class="file-icon">📄</span>
                                <span class="file-name">{displayName}</span>
                              </div>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}

                <!-- Starší roky - skryté -->
                {otherYears.map((year) => (
                  <div class="year-group extra-year-item" data-year={year} style="display: none;">
                    <h4 class="year-header">{year}</h4>
                    <div class="files-grid">
                      {pdfsByYear[year].map(({fileName, filePath}) => {
                        const displayName = fileName
                          .replace('.pdf', '')
                          .replace(/^\d{4}-\d{2}-\d{2}[-_]?/, '')
                          .replace(/[-_]/g, ' ')
                          .trim();
                        
                        return (
                          <div class="file-item-wrapper">
                            <a 
                              href={`/announcements/${filePath}`} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="file-item clickable"
                              aria-label={`Zobrazit ${displayName}`}
                            >
                              <div class="file-info">
                                <span class="file-icon">📄</span>
                                <span class="file-name">{displayName}</span>
                              </div>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Tlačítko pro načtení starších let -->
              {otherYears.length > 0 && (
                <div class="pagination">
                  <button class="load-more-btn" id="toggleExtraYears">
                    <span class="btn-text" id="btnText">
                      <span>📄 Zobrazit starší roky</span>
                      <span class="count">+{otherYears.length}</span>
                    </span>
                  </button>
                </div>
              )}
            </>
          )}
        </div>
      </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('toggleExtraYears');
      const extraYearItems = document.querySelectorAll('.extra-year-item');
      const btnText = document.getElementById('btnText');
      
      if (toggleBtn && extraYearItems.length > 0) {
        let isOpen = false;
        
        toggleBtn.addEventListener('click', () => {
          isOpen = !isOpen;
          
          extraYearItems.forEach(item => {
            item.style.display = isOpen ? 'block' : 'none';
          });
          
          if (isOpen) {
            btnText.innerHTML = '<span>▲ Zobrazit méně</span>';
          } else {
            btnText.innerHTML = '<span>📄 Zobrazit starší roky</span><span class="count">+' + extraYearItems.length + '</span>';
          }
        });
      }
    });
  </script>
</Layout>
