---
import Layout from '../layouts/Layout.astro';
import FontPreload from '../components/FontPreload.astro';
import fs from 'fs';
import path from 'path';

// Načtení PDF souborů z podsložek podle roku, dříve Boží slovo
const liturgicalTextsDir = path.join(process.cwd(), 'public', 'liturgical_texts');
let pdfsByYear: Record<string, Array<{fileName: string, filePath: string, modifiedTime: Date, originalMtime?: Date}>> = {};

// JSON metadata system pro zachování původních modification times
const metadataFile = path.join(liturgicalTextsDir, '.file-metadata.json');

function loadMetadata(): Record<string, string> {
  try {
    if (fs.existsSync(metadataFile)) {
      const content = fs.readFileSync(metadataFile, 'utf8');
      return JSON.parse(content);
    }
  } catch (error) {
    console.log('Warning: Could not load metadata file:', error);
  }
  return {};
}

function saveMetadata(metadata: Record<string, string>) {
  try {
    fs.writeFileSync(metadataFile, JSON.stringify(metadata, null, 2));
  } catch (error) {
    console.log('Warning: Could not save metadata file:', error);
  }
}

try {
  if (fs.existsSync(liturgicalTextsDir)) {
    // Load existing metadata
    const metadata = loadMetadata();
    const newMetadata = { ...metadata };
    let metadataChanged = false;
    const yearDirs = fs.readdirSync(liturgicalTextsDir, { withFileTypes: true })
      .filter(dirent => dirent.isDirectory());
    
    yearDirs.forEach(yearDir => {
      const year = yearDir.name;
      const yearPath = path.join(liturgicalTextsDir, year);
      
      if (fs.existsSync(yearPath)) {
        const files = fs.readdirSync(yearPath);
        const pdfFiles = files.filter(file => file.toLowerCase().endsWith('.pdf'));
        
        if (pdfFiles.length > 0) {
          pdfsByYear[year] = pdfFiles.map(file => {
            const fullFilePath = path.join(yearPath, file);
            const stats = fs.statSync(fullFilePath);
            const fileKey = `${year}/${file}`;
            
            // Store original mtime for new files
            if (!metadata[fileKey]) {
              newMetadata[fileKey] = stats.mtime.toISOString();
              metadataChanged = true;
            }
            
            // Use stored original time or current mtime as fallback
            const originalMtime = metadata[fileKey] 
              ? new Date(metadata[fileKey]) 
              : stats.mtime;
            
            return {
              fileName: file,
              filePath: `${year}/${file}`,
              modifiedTime: stats.mtime, // Current filesystem time
              originalMtime: originalMtime // Preserved original time for sorting
            };
          }).sort((a, b) => b.originalMtime!.getTime() - a.originalMtime!.getTime()); // Sort by original time
        }
      }
    });
    
    // Seřazení let sestupně (nejnovější první)
    const sortedYears = Object.keys(pdfsByYear).sort((a, b) => {
      if (a === 'Ostatní' || a === 'other' || a === 'Other') return 1;
      if (b === 'Ostatní' || b === 'other' || b === 'Other') return -1;
      
      const yearA = parseInt(a, 10);
      const yearB = parseInt(b, 10);
      
      if (isNaN(yearA) && isNaN(yearB)) return b.localeCompare(a);
      if (isNaN(yearA)) return -1;
      if (isNaN(yearB)) return 1;
      
      return yearB - yearA;
    });
    
    pdfsByYear = sortedYears.reduce((obj, key) => {
      obj[key] = pdfsByYear[key];
      return obj;
    }, {} as Record<string, Array<{fileName: string, filePath: string, modifiedTime: Date, originalMtime?: Date}>>);
    
    // Save metadata if there were changes
    if (metadataChanged) {
      saveMetadata(newMetadata);
    }
  }
} catch (error) {
  console.error('Chyba při načítání PDF souborů:', error);
}

// Získání aktuálního roku a rozdělení dat
const currentYear = new Date().getFullYear().toString();
const allYears = Object.keys(pdfsByYear);
const currentYearData = pdfsByYear[currentYear] || [];
// Obrácení pořadí let - od nejstaršího k aktuálnímu
const otherYears = allYears.filter(year => year !== currentYear).reverse();
---

<Layout 
  title="Boží slovo - Farnost Hrochův Týnec - Chroustovice"
  description="Liturgické texty, kalendář a zdroje pro farnost Hrochův Týnec - Chroustovice."
>
  <FontPreload />

  <div class="page-hero">
    <h2>Boží slovo</h2>
  </div>

  <section class="content-section">
    <div class="liturgical-files-section">
          
          {Object.keys(pdfsByYear).length === 0 ? (
            <div class="no-files">
              <p>Zatím nejsou k dispozici žádné liturgické texty ke stažení.</p>
            </div>
          ) : (
            <>
              <div class="files-by-year">
                <!-- Aktuální rok - vždy viditelný -->
                {currentYearData.length > 0 ? (
                  <div class="year-group" data-year={currentYear}>
                    <h4 class="year-header">{currentYear}</h4>
                    <div class="files-grid">
                      {currentYearData.map(({fileName, filePath}) => {
                        const displayName = fileName
                          .replace('.pdf', '')
                          .replace(/^\d{4}-\d{2}-\d{2}[-_]?/, '')
                          .replace(/[-_]/g, ' ')
                          .trim();
                        
                        return (
                          <a 
                            href={`/liturgical_texts/${filePath}`} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="file-item clickable"
                            aria-label={`Zobrazit ${displayName}`}
                          >
                            <div class="file-info">
                              <span class="file-icon">📄</span>
                              <span class="file-name">{displayName}</span>
                            </div>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                ) : allYears.length > 0 && (
                  <div class="year-group" data-year={allYears[0]}>
                    <h4 class="year-header">{allYears[0]}</h4>
                    <div class="files-grid">
                      {pdfsByYear[allYears[0]].map(({fileName, filePath}) => {
                        const displayName = fileName
                          .replace('.pdf', '')
                          .replace(/^\d{4}-\d{2}-\d{2}[-_]?/, '')
                          .replace(/[-_]/g, ' ')
                          .trim();
                        
                        return (
                          <div class="file-item-wrapper">
                            <a 
                              href={`/liturgical_texts/${filePath}`} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="file-item clickable"
                              aria-label={`Zobrazit ${displayName}`}
                            >
                              <div class="file-info">
                                <span class="file-icon">📄</span>
                                <span class="file-name">{displayName}</span>
                              </div>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}

                <!-- Starší roky - skrývané -->
                {otherYears.map((year) => (
                  <div class="year-group extra-year-item" data-year={year} style="display: none;">
                    <h4 class="year-header">{year}</h4>
                    <div class="files-grid">
                      {pdfsByYear[year].map(({fileName, filePath}) => {
                        const displayName = fileName
                          .replace('.pdf', '')
                          .replace(/^\d{4}-\d{2}-\d{2}[-_]?/, '')
                          .replace(/[-_]/g, ' ')
                          .trim();
                        
                        return (
                          <div class="file-item-wrapper">
                            <a 
                              href={`/liturgical_texts/${filePath}`} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="file-item clickable"
                              aria-label={`Zobrazit ${displayName}`}
                            >
                              <div class="file-info">
                                <span class="file-icon">📄</span>
                                <span class="file-name">{displayName}</span>
                              </div>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Tlačítko pro načtení starších let -->
              {otherYears.length > 0 && (
                <div class="pagination">
                  <button class="load-more-btn" id="toggleExtraYears">
                    <span class="btn-text" id="btnText">
                      <span>📅 Zobrazit starší roky</span>
                      <span class="count">+{otherYears.length}</span>
                    </span>
                  </button>
                </div>
              )}
            </>
          )}
        </div>
      </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('toggleExtraYears');
      const extraYearItems = document.querySelectorAll('.extra-year-item');
      const btnText = document.getElementById('btnText');
      
      if (toggleBtn && extraYearItems.length > 0) {
        let isOpen = false;
        
        toggleBtn.addEventListener('click', () => {
          isOpen = !isOpen;
          
          extraYearItems.forEach(item => {
            item.style.display = isOpen ? 'block' : 'none';
          });
          
          if (isOpen) {
            btnText.innerHTML = '<span>▲ Zobrazit méně</span>';
          } else {
            btnText.innerHTML = '<span>📅 Zobrazit starší roky</span><span class="count">+' + extraYearItems.length + '</span>';
          }
        });
      }
    });
  </script>
</Layout>
