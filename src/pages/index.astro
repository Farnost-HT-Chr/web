---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Farnost Hrochův Týnec - Chroustovice"
  description="Římskokatolická farnost Hrochův Týnec - Chroustovice. Informace o bohoslužbách, farním životě a akcích."
>
  <Fragment slot="head">
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://farnostht-chr.cz/" />
    <meta property="og:title" content="Farnost Hrochův Týnec - Chroustovice" />
    <meta property="og:description" content="Římskokatolická farnost Hrochův Týnec - Chroustovice. Informace o bohoslužbách, farním životě a akcích." />
    <meta property="og:image" content="https://farnostht-chr.cz/images/cover.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://farnostht-chr.cz/" />
    <meta property="twitter:title" content="Farnost Hrochův Týnec - Chroustovice" />
    <meta property="twitter:description" content="Římskokatolická farnost Hrochův Týnec - Chroustovice. Informace o bohoslužbách, farním životě a akcích." />
    <meta property="twitter:image" content="https://farnostht-chr.cz/images/cover.webp" />
    
    <!-- Font preloads -->
    <link rel="preload" href="/fonts/Ohrada.otf" as="font" type="font/otf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/HelveticaNow.otf" as="font" type="font/otf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/HelveticaNowBold.otf" as="font" type="font/otf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/OpenSans-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/OpenSans-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/OpenSans-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </Fragment>

  <!-- HLAVNÍ OBSAH STRÁNKY -->
  <div class="cover">
    <div class="cover-content">
      <div class="cover-text">
        <h2>Vítejte v naší farnosti</h2>
        <p class="verse">
          „Hledejte Hospodina, dokud je možno ho najít, volejte ho, dokud je blízko."<br/>
          (Iz 55,6)
        </p>
      </div>
    </div>
  </div>

  <!-- O farnosti -->
  <section id="about">
    <h2 class="about-flex">Bohoslužby a duchovní život</h2>

    <div class="about-flex" style="margin-top: 3rem;">
      <div class="about-text">
        <h2>Přijďte mezi nás</h2>
        <p>
          Ať už jste stálý obyvatel našich obcí, nebo jen návštěvník, 
          srdečně vás zveme na bohoslužby a do našeho farního společenství. 
          Těšíme se na setkání s vámi!
        </p>
      </div>
    </div>
  </section>
</Layout>
