---
import Layout from '../layouts/Layout.astro';
import FontPreload from '../components/FontPreload.astro';
import CalendarCards from '../components/CalendarCards.astro';
---

<Layout 
  title="Farnost Hrochův Týnec - Chroustovice"
  description="Římskokatolická farnost Hrochův Týnec - Chroustovice. Informace o bohoslužbách, farním životě a akcích."
>
  <Fragment slot="head">
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://farnostht-chr.cz/" />
    <meta property="og:title" content="Farnost Hrochův Týnec - Chroustovice" />
    <meta property="og:description" content="Římskokatolická farnost Hrochův Týnec - Chroustovice. Informace o bohoslužbách, farním životě a akcích." />
    <meta property="og:image" content="https://farnostht-chr.cz/images/cover.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://farnostht-chr.cz/" />
    <meta property="twitter:title" content="Farnost Hrochův Týnec - Chroustovice" />
    <meta property="twitter:description" content="Římskokatolická farnost Hrochův Týnec - Chroustovice. Informace o bohoslužbách, farním životě a akcích." />
    <meta property="twitter:image" content="https://farnostht-chr.cz/images/cover.webp" />
    
    <FontPreload />
  </Fragment>

  <!-- HLAVNÍ OBSAH STRÁNKY -->
  <div class="cover">
    <div class="cover-content">
      <div class="cover-text">
        <h2>Pochválen buď Ježíš Kristus! <br>
          Vítejte v naší farnosti</h2>
        
        <!-- Slider s fotkami kostelů -->
        <div class="church-slider">
          <div class="slider-container">
            <div class="slider-track">
              <div class="slide">
                <img src="/images/kostelht.webp" alt="Kostel Hrochův Týnec" />
                <div class="slide-caption">Kostel Hrochův Týnec</div>
              </div>
              <div class="slide">
                <img src="/images/kostelchr.webp" alt="Kostel Chroustovice" />
                <div class="slide-caption">Kostel Chroustovice</div>
              </div>
              <div class="slide">
                <img src="/images/kostelhonbice.webp" alt="Kostel Honbice" />
                <div class="slide-caption">Kostel Honbice</div>
              </div>
              <div class="slide">
                <img src="/images/kosteltroj.webp" alt="Kostel Trojovice" />
                <div class="slide-caption">Kostel Trojovice</div>
              </div>
            </div>
          </div>
          
          <!-- Navigační tlačítka -->
          <div class="slider-controls">
            <button class="prev-btn" onclick="changeSlide(-1)">‹</button>
            <button class="next-btn" onclick="changeSlide(1)">›</button>
          </div>
          
          <!-- Dot indikátory -->
          <div class="slider-dots">
            <span class="dot active" onclick="currentSlide(1)"></span>
            <span class="dot" onclick="currentSlide(2)"></span>
            <span class="dot" onclick="currentSlide(3)"></span>
            <span class="dot" onclick="currentSlide(4)"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Novinky -->
  <section id="about">
    <h2 class="about-flex">Novinky</h2>

    <div class="about-flex">
      <div class="news-cards-container">
        <div class="news-cards">

    <a href="/news/sbirka-media" class="news-card-link">
            <div class="news-card news-card-with-bg" style="background-image: url('/images/news/sbirka-media.webp')">
              <div class="news-card-header">
                <h3>Sbírka na katolické média</h3>
              </div>
            </div>
          </a>

          <a href="/news/objednani-intence" class="news-card-link">
            <div class="news-card news-card-with-bg" style="background-image: url('/images/news/novinky.webp')">
              <div class="news-card-header">
                <h3>Objednání intence mše sv.</h3>
              </div>
            </div>
          </a>

          <a href="/news/katecheze" class="news-card-link">
            <div class="news-card news-card-with-bg" style="background-image: url('/images/news/katecheze.webp')">
              <div class="news-card-header">
                <h3>Pozvánka na katechezi</h3>
              </div>
            </div>
          </a>
          
          <a href="/news/prvni-patek-sobota" class="news-card-link">
            <div class="news-card news-card-with-bg" style="background-image: url('/images/news/srdce.webp')">
              <div class="news-card-header">
                <h3>První pátek a sobota v měsíci</h3>
              </div>
            </div>
          </a>
          
          <a href="/news/pozvanka-fara" class="news-card-link">
            <div class="news-card news-card-with-bg" style="background-image: url('/images/news/pozvani.webp')">
              <div class="news-card-header">
                <h3>Pozvánka na faru po mši sv. v Hrochově Týnci</h3>
              </div>
            </div>
          </a>
          
        </div>
      </div>
    </div>
  </section>

  <!-- O farnosti -->
  <section id="about">
    <h2 class="about-flex">Bohoslužby a nadcházející akce</h2>

    <!-- Actions Container with Border -->
    <div class="actions-container">
      <div class="actions-content">
        <!-- Event Cards Container - nyní server-side rendered -->
        <CalendarCards />
      </div>
    </div>
  </section>
</Layout>
