---
import Layout from '../layouts/Layout.astro';
import FontPreload from '../components/FontPreload.astro';
import fs from 'fs';
import path from 'path';

// Funkce pro načtení počtu fotek z adresáře
function countImagesInDir(dirPath: string) {
  try {
    return fs.readdirSync(dirPath)
      .filter(file => 
        file.toLowerCase().endsWith('.jpg') || 
        file.toLowerCase().endsWith('.jpeg') || 
        file.toLowerCase().endsWith('.png') || 
        file.toLowerCase().endsWith('.webp')
      ).length;
  } catch (error) {
    return 0;
  }
}

// Funkce pro získání první fotky z adresáře
function getFirstImage(dirPath: string, subdirectory?: string) {
  try {
    const images = fs.readdirSync(dirPath)
      .filter(file => 
        file.toLowerCase().endsWith('.jpg') || 
        file.toLowerCase().endsWith('.jpeg') || 
        file.toLowerCase().endsWith('.png') || 
        file.toLowerCase().endsWith('.webp')
      )
      .sort();
    
    if (images.length > 0) {
      return subdirectory ? `/images/gallery/${subdirectory}/${images[0]}` : `/images/gallery/${images[0]}`;
    }
    return null;
  } catch (error) {
    return null;
  }
}

// Definice galerií
const galleryPath = path.join(process.cwd(), 'public', 'images', 'gallery');

// Funkce pro správný skloňování textu fotografií
function getPhotoText(count: number) {
  if (count === 1) return 'fotografie';
  if (count <= 4) return 'fotografie';
  return 'fotografií';
}

const galleries = [
  { 
    id: 'chroustovice', 
    name: 'Chroustovice', 
    description: 'Fotografie z kostela a akcí v Chroustovicích',
    count: countImagesInDir(path.join(galleryPath, 'chroustovice')),
    previewImage: getFirstImage(path.join(galleryPath, 'chroustovice'), 'chroustovice'),
    url: '/galerie/chroustovice'
  },
  { 
    id: 'duchovni_obnova', 
    name: 'Duchovní obnova', 
    description: 'Fotografie z duchovní obnovy',
    count: countImagesInDir(path.join(galleryPath, 'duchovni_obnova')),
    previewImage: getFirstImage(path.join(galleryPath, 'duchovni_obnova'), 'duchovni_obnova'),
    url: '/galerie/duchovni-obnova'
  },
  { 
    id: 'farni_kavarna', 
    name: 'Farní kavárna', 
    description: 'Fotografie z farní kavárny a společenských setkání',
    count: countImagesInDir(path.join(galleryPath, 'farni_kavarna')),
    previewImage: getFirstImage(path.join(galleryPath, 'farni_kavarna'), 'farni_kavarna'),
    url: '/galerie/farni-kavarna'
  },
  { 
    id: 'farni_rada', 
    name: 'Farní rada', 
    description: 'Fotografie z jednání a aktivit farní rady',
    count: countImagesInDir(path.join(galleryPath, 'farni_rada')),
    previewImage: getFirstImage(path.join(galleryPath, 'farni_rada'), 'farni_rada'),
    url: '/galerie/farni-rada'
  },
  { 
    id: 'hrochuv_tynec', 
    name: 'Hrochův Týnec', 
    description: 'Fotografie z kostela a akcí v Hrochově Týnci',
    count: countImagesInDir(path.join(galleryPath, 'hrochuv_tynec')),
    previewImage: getFirstImage(path.join(galleryPath, 'hrochuv_tynec'), 'hrochuv_tynec'),
    url: '/galerie/hrochuv-tynec'
  },
  { 
    id: 'pruvod', 
    name: 'Průvod', 
    description: 'Fotografie z průvodů a procesí',
    count: countImagesInDir(path.join(galleryPath, 'pruvod')),
    previewImage: getFirstImage(path.join(galleryPath, 'pruvod'), 'pruvod'),
    url: '/galerie/pruvod'
  },
  { 
    id: 'prvni_sv_prijimani', 
    name: 'První svaté přijímání', 
    description: 'Fotografie z prvního svatého přijímání dětí',
    count: countImagesInDir(path.join(galleryPath, 'prvni_sv_prijimani')),
    previewImage: getFirstImage(path.join(galleryPath, 'prvni_sv_prijimani'), 'prvni_sv_prijimani'),
    url: '/galerie/prvni-sv-prijimani'
  },
  { 
    id: 'prvni_sv_prijimani_2024', 
    name: 'První svaté přijímání 2024', 
    description: 'Fotografie z prvního svatého přijímání dětí v roce 2024',
    count: countImagesInDir(path.join(galleryPath, 'prvni_sv_prijimani_2024')),
    previewImage: getFirstImage(path.join(galleryPath, 'prvni_sv_prijimani_2024'), 'prvni_sv_prijimani_2024'),
    url: '/galerie/prvni-sv-prijimani-2024'
  },
  { 
    id: 'sbor', 
    name: 'Sbor', 
    description: 'Fotografie ze sborových aktivit a setkání',
    count: countImagesInDir(path.join(galleryPath, 'sbor')),
    previewImage: getFirstImage(path.join(galleryPath, 'sbor'), 'sbor'),
    url: '/galerie/sbor'
  },
  { 
    id: 'trikralova_sbirka', 
    name: 'Tříkrálová sbírka', 
    description: 'Fotografie z Tříkrálové sbírky a koledování',
    count: countImagesInDir(path.join(galleryPath, 'trikralova_sbirka')),
    previewImage: getFirstImage(path.join(galleryPath, 'trikralova_sbirka'), 'trikralova_sbirka'),
    url: '/galerie/trikralova-sbirka'
  },
  { 
    id: 'ostatni', 
    name: 'Ostatní fotografie', 
    description: 'Další fotografie ze života farnosti',
    count: countImagesInDir(galleryPath) - fs.readdirSync(galleryPath).filter(item => 
      fs.statSync(path.join(galleryPath, item)).isDirectory()
    ).length,
    previewImage: getFirstImage(galleryPath),
    url: '/galerie/ostatni'
  }
];

// Filtrování galerií s fotkami
const activeGalleries = galleries.filter(gallery => gallery.count > 0);
const totalImages = activeGalleries.reduce((sum, gallery) => sum + gallery.count, 0);
---

<Layout 
  title="Galerie - Farnost Hrochův Týnec - Chroustovice"
  description="Fotogalerie ze života farnosti Hrochův Týnec - Chroustovice."
>
  <FontPreload />

  <div class="container">
    <h1 class="page-title">Galerie</h1>
    
    {activeGalleries.length > 0 ? (
      <div class="gallery-overview">
        {activeGalleries.map((gallery) => (
          <a href={gallery.url} class="gallery-card">
            <div class="gallery-card-image">
              {gallery.previewImage ? (
                <img 
                  src={gallery.previewImage} 
                  alt={`Náhled galerie ${gallery.name}`}
                  loading="lazy"
                />
              ) : (
                <div class="placeholder-image">
                  📸
                </div>
              )}
              <div class="gallery-card-overlay">
                {gallery.count} {getPhotoText(gallery.count)}
              </div>
            </div>
            <div class="gallery-card-content">
              <h2 class="gallery-card-title">{gallery.name}</h2>
              <p class="gallery-card-description">{gallery.description}</p>
              <div class="gallery-card-stats">
                <span class="gallery-card-link">
                  Zobrazit galerii →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="liturgical-files-section">
        <div class="content-text">
          <div class="preparation-message">
            <p>Momentálně nejsou k dispozici žádné fotografie</p>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
