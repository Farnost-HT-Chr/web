---
// @ts-nocheck
---

<div class="event-cards-container" id="calendar-cards">
  <div class="loading-message">Načítám nadcházející akce...</div>
</div>

<script>
  // @ts-nocheck

  /**
   * @typedef {Object} CalendarEvent
   * @property {string=} summary
   * @property {{ dateTime?: string, date?: string }=} start
   */

  const API_KEY = 'AIzaSyDKi8TYFz1MK3kekjHKrGAveum1EewoZzA';
  const CALENDAR_IDS = [
    'c5ec6d5e48c7e538fc249a79a499bb2a7f014604f1f3aba049e767ff21aedcaf@group.calendar.google.com',
    '8a4cfcf8e209162a9eaad4ac5aca64af38b3eb024eab92685e2cffcc34a100d1@group.calendar.google.com'
  ];
  const REFRESH_INTERVAL_MS = 10 * 60 * 1000;

  const cardsContainer = document.getElementById('calendar-cards');

  /** @param {string} message */
  function renderMessage(message) {
    if (!cardsContainer) return;
    cardsContainer.innerHTML = '';

    const messageNode = document.createElement('div');
    messageNode.className = 'loading-message';
    messageNode.textContent = message;
    cardsContainer.appendChild(messageNode);
  }

  /** @param {string} placeCode */
  function convertPlaceCode(placeCode) {
    /** @type {Record<string, string>} */
    const placeMap = {
      HT: 'Hrochův Týnec',
      CHR: 'Chroustovice',
      HON: 'Honbice',
      TROJ: 'Trojovice',
      'HROCHUV TYNEC': 'Hrochův Týnec',
      CHROUSTOVICE: 'Chroustovice',
      HONBICE: 'Honbice',
      TROJOVICE: 'Trojovice'
    };

    const normalized = placeCode
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toUpperCase();

    return placeMap[normalized] || placeCode;
  }

  /** @param {string} time */
  function normalizeTime(time) {
    return time.replace(/[.,]/, ':');
  }

  /** @param {string} title */
  function fallbackParsing(title) {
    const timeMatch = title.match(/(\d{1,2}[\.:,]\d{2})/);
    const time = timeMatch ? normalizeTime(timeMatch[1]) : '';

    const placePatterns = [
      { regex: /\b(HT|Hrochův\s+Týnec)\b/i, name: 'Hrochův Týnec' },
      { regex: /\b(CHR|Chroustovice)\b/i, name: 'Chroustovice' },
      { regex: /\b(Hon|Honbice)\b/i, name: 'Honbice' },
      { regex: /\b(Troj|Trojovice)\b/i, name: 'Trojovice' }
    ];

    let place = '';
    let placeMatch = null;

    for (const { regex, name } of placePatterns) {
      const match = title.match(regex);
      if (match) {
        place = name;
        placeMatch = match[0];
        break;
      }
    }

    let intention = title;
    if (timeMatch) intention = intention.replace(timeMatch[0], '');
    if (placeMatch) intention = intention.replace(placeMatch, '');

    intention = intention
      .replace(/^[\s\-–—−,.:;]+|[\s\-–—−,.:;]+$/g, '')
      .replace(/\s+/g, ' ')
      .trim();

    return {
      time,
      place,
      intention: intention || 'Mše svatá'
    };
  }

  /** @param {string} title */
  function parseMassTitle(title) {
    if (!title) return { time: '', place: '', intention: '' };

    const normalizedTitle = title
      .replace(/[–—−]/g, '-')
      .replace(/\s+/g, ' ')
      .trim();

    const mainPattern = /^(HT|CHR\.?|Hrochův Týnec|Chroustovice|Hon|Honbice|Troj|Trojovice)\s+v\s+(\d{1,2}[\.:,]\d{2})\s*-\s*(.*)$/i;
    const mainMatch = normalizedTitle.match(mainPattern);

    if (mainMatch) {
      const [, placeCode, time, intention] = mainMatch;
      return {
        time: normalizeTime(time),
        place: convertPlaceCode(placeCode.replace('.', '')),
        intention: intention.trim()
      };
    }

    const fallbackPatterns = [
      /^(?:mše\s+svatá\s+)?(.+?)\s+(\d{1,2}[\.:,]\d{2})\s*-\s*(.*)$/i,
      /^(\d{1,2}[\.:,]\d{2})\s+(HT|CHR\.?|Hrochův Týnec|Chroustovice|Hon|Honbice|Troj|Trojovice)\s*-\s*(.*)$/i,
      /^(HT|CHR\.?|Hrochův Týnec|Chroustovice|Hon|Honbice|Troj|Trojovice)\s+(\d{1,2}[\.:,]\d{2})\s+(.*)$/i
    ];

    for (const pattern of fallbackPatterns) {
      const match = normalizedTitle.match(pattern);
      if (!match) continue;

      let place;
      let time;
      let intention;

      if (pattern === fallbackPatterns[1]) {
        [, time, place, intention] = match;
      } else {
        [, place, time, intention] = match;
      }

      return {
        time: normalizeTime(time),
        place: convertPlaceCode(place.replace('.', '')),
        intention: intention.trim() || 'Mše svatá'
      };
    }

    return fallbackParsing(normalizedTitle);
  }

  /** @param {CalendarEvent} event */
  function getEventStart(event) {
    return new Date(event.start.dateTime || event.start.date);
  }

  /** @param {string} time */
  function timeToMinutes(time) {
    const match = time.match(/^(\d{1,2}):(\d{2})$/);
    if (!match) return Number.MAX_SAFE_INTEGER;

    const hours = Number.parseInt(match[1], 10);
    const minutes = Number.parseInt(match[2], 10);

    if (Number.isNaN(hours) || Number.isNaN(minutes)) {
      return Number.MAX_SAFE_INTEGER;
    }

    return (hours * 60) + minutes;
  }

  /** @param {CalendarEvent} event */
  function getEventSortValues(event) {
    const start = getEventStart(event);
    const dayStart = new Date(start);
    dayStart.setHours(0, 0, 0, 0);

    // Prefer exact event time from calendar, fallback to time parsed from title.
    let minutesInDay = Number.MAX_SAFE_INTEGER;

    if (event.start.dateTime) {
      minutesInDay = (start.getHours() * 60) + start.getMinutes();
    } else {
      const parsed = parseMassTitle(event.summary || '');
      minutesInDay = timeToMinutes(parsed.time);
    }

    return {
      dayTimestamp: dayStart.getTime(),
      minutesInDay,
      startTimestamp: start.getTime()
    };
  }

  /** @returns {Promise<CalendarEvent[]>} */
  async function getEvents() {
    const nowIso = new Date().toISOString();
    const timeMaxIso = new Date(Date.now() + (30 * 24 * 60 * 60 * 1000)).toISOString();

    const eventChunks = await Promise.all(
      CALENDAR_IDS.map(async (id) => {
        const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(id)}/events?key=${API_KEY}&timeMin=${nowIso}&timeMax=${timeMaxIso}&orderBy=startTime&singleEvents=true&maxResults=20`;

        try {
          const response = await fetch(url);
          const data = await response.json();
          return Array.isArray(data.items) ? data.items : [];
        } catch (error) {
          console.error('Error fetching calendar:', error);
          return [];
        }
      })
    );

    const allEvents = eventChunks.flat();
    const currentTime = new Date();
    const todayStart = new Date();
    todayStart.setHours(0, 0, 0, 0);

    return allEvents
      .filter((event) => {
        if (!event || !event.start) return false;

        const eventDateTime = getEventStart(event);
        if (Number.isNaN(eventDateTime.getTime())) return false;

        if (event.start.date && !event.start.dateTime) {
          return eventDateTime >= todayStart;
        }

        return eventDateTime > currentTime;
      })
      .sort((a, b) => {
        const aSort = getEventSortValues(a);
        const bSort = getEventSortValues(b);

        if (aSort.dayTimestamp !== bSort.dayTimestamp) {
          return aSort.dayTimestamp - bSort.dayTimestamp;
        }

        if (aSort.minutesInDay !== bSort.minutesInDay) {
          return aSort.minutesInDay - bSort.minutesInDay;
        }

        return aSort.startTimestamp - bSort.startTimestamp;
      })
      .slice(0, 4);
  }

  /** @param {CalendarEvent[]} events */
  function renderEvents(events) {
    if (!cardsContainer) return;
    cardsContainer.innerHTML = '';

    if (!events.length) {
      renderMessage('Žádné nadcházející mše nenalezeny.');
      return;
    }

    for (const event of events) {
      const parsed = parseMassTitle(event.summary || '');
      const eventDate = getEventStart(event);

      const card = document.createElement('div');
      card.className = 'event-card mass-card';

      const details = document.createElement('div');
      details.className = 'mass-details';

      const date = document.createElement('div');
      date.className = 'mass-date';
      date.textContent = eventDate.toLocaleDateString('cs-CZ', {
        weekday: 'short',
        day: 'numeric',
        month: 'long'
      });

      const time = document.createElement('div');
      time.className = 'mass-time';
      time.textContent = `⏰ ${parsed.time || 'bez času'}`;

      const place = document.createElement('div');
      place.className = 'mass-place';
      place.textContent = `⛪ ${parsed.place || 'bez místa'}`;

      const intention = document.createElement('div');
      intention.className = 'mass-intention';
      intention.textContent = `🙏 ${parsed.intention || 'Mše svatá'}`;

      details.appendChild(date);
      details.appendChild(time);
      details.appendChild(place);
      details.appendChild(intention);
      card.appendChild(details);
      cardsContainer.appendChild(card);
    }
  }

  async function refreshEvents() {
    try {
      const events = await getEvents();
      renderEvents(events);
    } catch (error) {
      console.error('Failed to refresh events:', error);
      renderMessage('Nepodařilo se načíst kalendář.');
    }
  }

  refreshEvents();
  setInterval(refreshEvents, REFRESH_INTERVAL_MS);
</script>